# Copy to apps/web/.env.local. Never commit actual values.
APP_ENV=development
APP_URL=http://127.0.0.1:3000
VERIFY_URL=http://127.0.0.1:3000/v
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Not used in the regular user request path.
SUPABASE_SECRET_KEY=
GARANT_SUPABASE_PROJECT_REF=
# Application pooler transaction connection; migrations use DIRECT_DATABASE_URL.
DATABASE_URL=
DIRECT_DATABASE_URL=
# Future signing/encryption providers. Empty => issuance unavailable.
MASTER_ENCRYPTION_KEY=
VISUAL_SECRET=
PHONE_HMAC_SECRET=
# Issuer private keys and PDF certificates must be managed outside Git.
ISSUER_KEY_PROVIDER=
PDF_SIGNING_PROVIDER=
PDF_VALIDATOR_COMMAND=
# Future SMS adapters: no live sends enabled by default.
SMS_PROVIDER=disabled
NIMBA_API_KEY=
ANDROID_SMS_GATEWAY_URL=
ANDROID_SMS_GATEWAY_TOKEN=
ANDROID_SMS_WEBHOOK_SECRET=
