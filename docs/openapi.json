{
  "openapi": "3.1.0",
  "info": {
    "title": "GARANT V3 — API interne à session",
    "version": "0.3.0-dev",
    "description": "Contrat local. Aucun client externe provisionné ni parcours d’émission actif."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000"
    }
  ],
  "paths": {
    "/api/v1/organizations": {
      "post": {
        "operationId": "createOrganization",
        "summary": "Interne : Organization",
        "security": [
          {
            "supabaseSession": []
          }
        ],
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Organization"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Créé (organisations, types et brouillons)"
          },
          "200": {
            "description": "Succès (habilitations, délégations, approbations)"
          },
          "400": {
            "description": "Entrée ou opération refusée"
          },
          "401": {
            "description": "Session absente ou expirée"
          },
          "403": {
            "description": "Origine ou MFA refusé"
          },
          "503": {
            "description": "Configuration ou base indisponible"
          }
        }
      },
      "get": {
        "summary": "Lister les organisations autorisées",
        "security": [
          {
            "supabaseSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Organisations filtrées par RLS"
          },
          "401": {
            "description": "Session requise"
          },
          "403": {
            "description": "MFA requise"
          },
          "503": {
            "description": "Indisponible"
          }
        }
      }
    },
