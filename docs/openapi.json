  "components": {
    "securitySchemes": {
      "supabaseSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sb-<project-ref>-auth-token",
        "description": "Cookie SSR Supabase ; le nom et le découpage effectifs sont gérés par @supabase/ssr."
      }
    },
    "schemas": {
      "Organization": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 180
          },
          "acronym": {
            "type": "string",
            "maxLength": 30
          },
          "category": {
            "type": "string",
            "enum": [
              "public",
              "private",
              "association",
              "other"
            ]
          },
          "country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "city": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "name",
          "category",
          "country",
          "city"
        ]
      },
      "Membership": {
        "type": "object",
        "properties": {
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "organization_admin",
              "approver",
              "issuer",
              "reader"
            ]
          }
        },
        "required": [
          "organizationId",
          "userId",
          "role"
        ]
      },
      "Delegation": {
        "type": "object",
        "properties": {
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "documentTypeId": {
            "type": "string",
            "format": "uuid"
          },
          "until": {
            "type": "string",
            "format": "date-time"
          },
          "canApprove": {
            "type": "boolean"
          },
          "canIssue": {
            "type": "boolean"
          }
        },
        "required": [
          "organizationId",
          "userId",
          "documentTypeId",
          "until",
          "canApprove",
          "canIssue"
        ]
      },
      "DocumentType": {
        "type": "object",
        "properties": {
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{1,60}$"
          },
          "name": {
            "type": "string"
          },
          "schema": {
            "type": "object",
            "required": [
              "fields"
            ],
            "properties": {
              "fields": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 30,
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "type",
                    "required"
                  ],
                  "properties": {
                    "type": {
                      "const": "string"
                    },
                    "required": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "confidentiality": {
            "type": "string",
            "enum": [
              "private",
              "public_summary"
            ]
          }
        },
        "required": [
          "organizationId",
          "code",
          "name",
          "schema"
        ]
      },
      "Draft": {
        "type": "object",
        "properties": {
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "typeVersionId": {
            "type": "string",
            "format": "uuid"
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "content": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "maxLength": 5000
            }
          }
        },
        "required": [
          "organizationId",
          "typeVersionId",
          "reference",
          "content"
        ]
      },
      "Approval": {
        "type": "object",
        "properties": {
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "versionId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "organizationId",
          "versionId",
          "expectedHash"
        ]
      }
    }
  }
}
