{
  "name": "garant",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "turbo dev --filter=@garant/web --filter=@garant/verifier --filter=@garant/landing",
    "dev:web": "pnpm --filter @garant/web dev",
    "dev:verifier": "pnpm --filter @garant/verifier dev",
    "dev:landing": "pnpm --filter @garant/landing dev",
    "lint": "eslint apps packages tests",
    "typecheck": "turbo typecheck && tsc --noEmit -p tsconfig.json",
    "build": "turbo build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "turbo": "2.11.8",
    "typescript": "5.9.3",
    "eslint": "9.39.1",
    "@eslint/js": "9.39.1",
    "typescript-eslint": "8.70.1",
    "eslint-config-next": "16.4.0",
    "vitest": "5.0.4",
    "@types/node": "24.10.0"
  },
  "type": "module"
}
